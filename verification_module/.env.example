# Copy this file to .env and fill in whichever free-tier keys you
# have. Every key is OPTIONAL -- adapters with no key are skipped
# automatically, and Wikipedia (no key needed) always runs.

# newsapi.org -- free dev tier, 100 req/day
NEWSAPI_KEY=

# gnews.io -- free tier, 100 req/day
GNEWS_KEY=

# Google Programmable Search Engine (Custom Search JSON API)
# Create at: https://programmablesearchengine.google.com/
# Free tier: 100 queries/day
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Google Fact Check Tools API -- free
# Enable at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_KEY=
